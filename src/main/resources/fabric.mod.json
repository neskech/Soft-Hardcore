{
	"schemaVersion": 1,
	"id": "softhardcore",
	"version": "${version}",
	"name": "SoftHardcore",
	"description": "A soft-hardcore, highly configurable mod that gives each player a limited number of lives. Once players die, they are banned for a configurable amount of time. Other players can drop hearts to give players back lives.",
	"authors": [
		"Neskech",
		"AlternateFire"
	],
	"contact": {
		"homepage": "https://github.com/neskech/Soft-Hardcore",
		"sources": "https://github.com/neskech/Soft-Hardcore"
	},
	"license": "MIT",
	"icon": "assets/softhardcore/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.ness.softhardcore.SoftHardcore"
		],
		"client": [
			"net.ness.softhardcore.SoftHardcoreClient"
		],
		"fabric-datagen": [
			"net.ness.softhardcore.SofthardcoreDataGenerator"
		]
	},
	"mixins": [
		"softhardcore.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.10",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
